# ── Hyperliquid ──────────────────────────────────────────────────────────────
# Agent wallet private key (NOT your main wallet — use API/Agent wallet only)
# Create at: https://app.hyperliquid-testnet.xyz → Settings → API
HL_AGENT_PRIVATE_KEY=0x_your_agent_wallet_private_key_here

# Your MAIN wallet address (used for account balance queries)
HL_ACCOUNT_ADDRESS=0x_YourMainWalletAddressHere

# Testnet toggle — keep "true" until everything works, then switch to "false"
HL_TESTNET=true

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose your AI provider: grok | openai | deepseek | anthropic
# Only the API key for the selected provider is required
AI_PROVIDER=deepseek

# Optional: override the default model for your chosen provider
# Defaults: grok=grok-4.20-0309-reasoning, openai=gpt-4o,
#           deepseek=deepseek-reasoner, anthropic=claude-opus-4-5
# For AgentRouter, try: glm-4.5, glm-4.6, gpt-4, or deepseek-v3.1, for sumopod try: deepseek-v4-pro
AI_MODEL=deepseek-reasoner

# ── AI API Keys (only fill the one matching AI_PROVIDER) ─────────────────────
XAI_API_KEY=                 # Grok (xAI)      → https://console.x.ai
OPENAI_API_KEY=              # OpenAI           → https://platform.openai.com
DEEPSEEK_API_KEY=            # AgentRouter/DeepSeek → https://agentrouter.org 
ANTHROPIC_API_KEY=           # Anthropic/Claude → https://console.anthropic.com

# ── Discord ───────────────────────────────────────────────────────────────────
# Get bot token from: discord.com/developers/applications → Bot
DISCORD_BOT_TOKEN=your_bot_token_here

# Right-click server name → Copy Server ID (need Developer Mode enabled)
DISCORD_GUILD_ID=your_guild_id_here

# Right-click channel → Copy Channel ID
DISCORD_CHANNEL_ID=your_channel_id_here

# Right-click role → Copy Role ID (only this role can use the bot)
DISCORD_AUTHORIZED_ROLE_ID=your_role_id_here

# ── Monitor Intervals ─────────────────────────────────────────────────────────
# MONITOR_PRICE_SEC: price + hard rules check (min 5s, default 10s)
MONITOR_PRICE_SEC=10

# MONITOR_AI_SEC: AI position analysis interval (min 60s, default 1200s = 20min)
# Increase to save API costs, decrease for more active management
MONITOR_AI_SEC=1200

# MONITOR_AI_INTERVAL: timeframe for monitor TA snapshots (default 4h)
MONITOR_AI_INTERVAL=4h

# Enable/disable AI scoring (true = use AI, false = skip AI and only use pre-filter)
ENABLE_AI=true

ENABLE_PREFILTER=true

# ── TradingView MCP (optional) ──────────────────────────────────────────────
# Only needed if uvx is not in PATH on your VPS
MCP_TA_COMMAND=uvx

# ── Altfins verification (optional) ─────────────────────────────────────────
# OHLCV secondary source for /verify cross-check
ALTFINS_API_KEY=your_altfins_api_key_here
